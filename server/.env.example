PORT=3001
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# MySQL / TiDB Cloud
DATABASE_HOST=
DATABASE_PORT=4000
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=dieselflow
# Set to false for a local MySQL without TLS
DATABASE_SSL=true
